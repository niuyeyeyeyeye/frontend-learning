# ============================================================
# .env.example —— 环境变量模板（这个文件要提交到 git）
# ============================================================
# 用法：复制一份 .env.local，把值换成你自己的：
#   copy .env.example .env.local
#
# ⚠️ 规则：只有 VITE_ 开头的变量才会被打包进前端代码！
#    没有 VITE_ 前缀的变量，前端读不到（这是 Vite 的安全设计）。

# 应用标题（会显示在页面顶部）
VITE_APP_TITLE=React 学习中

# 接口地址（真实项目里开发/测试/生产各不相同）
VITE_API_BASE_URL=/api

# ⚠️ 下面这种写法是**错的**，永远不要在前端放密钥：
# VITE_API_SECRET=sk-xxxxxxxx
# 原因：VITE_ 开头的变量会被原样打进 JS 文件，任何人 F12 都能看到。
# 真正的密钥必须放在后端，或者用后端签名/代理。
